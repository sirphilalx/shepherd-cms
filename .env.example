# Copy to .env.local and fill in. .env.local is gitignored.

# --- Sanity (content) ---------------------------------------------------
# Public: safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional — defaults to a recent date in sanity/env.ts
# NEXT_PUBLIC_SANITY_API_VERSION=2026-08-29

# Server-only. Sanity "Viewer" token (can read drafts, needed by the admin
# review-queue helpers). NEVER prefix this with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# --- Clerk (auth) -----------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
